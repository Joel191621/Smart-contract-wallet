# Sepolia RPC URL (Alchemy, Infura, or another Sepolia RPC)
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Factory deployed on Sepolia
VITE_FACTORY_ADDRESS=

# Optional: legacy/static wallet address for an already-deployed wallet
VITE_SMART_WALLET_ADDRESS=

# Optional deployment signer used ONLY by Hardhat scripts; never expose this in VITE_* variables
PRIVATE_KEY=
